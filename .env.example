# Required: any standards-compatible Base JSON-RPC URL
# Prefer a stable public endpoint (mainnet.base.org rate-limits aggressively)
BASE_RPC_URL=https://base.publicnode.com

# Telegram (optional — watcher runs without them; alerts/heartbeats skipped)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Full bag to quote (human-readable; decimals read from CX contract)
CX_AMOUNT=11577.51

# Poll / heartbeat
POLL_INTERVAL_MS=30000
HEARTBEAT_INTERVAL_MS=21600000

# Window boundary (lower tick of the big CL position)
TICK_BOUNDARY=-115800
TICK_UPPER=-94800

# Active-liquidity corroboration (big position ~4.42e22 when in range)
BIG_LIQUIDITY_MIN=1000000000000000000000

# USD alert tiers (full-bag quote value)
ALERT_WATCH_USD=200
ALERT_GOOD_USD=300
ALERT_STRONG_USD=400
ALERT_VERY_STRONG_USD=500

# Display-only 1% min-out reference (basis points; 100 = 1%)
QUOTE_SLIPPAGE_REF_BPS=100

# Alert on window close (true/false)
ALERT_ON_WINDOW_CLOSE=true

# Contracts (defaults match Aerodrome Slipstream Initial Deployment on Base)
# Source: https://github.com/aerodrome-finance/slipstream/blob/main/README.md
CX_ADDRESS=0x000000000000012DeF132E61759048bE5b5C6033
WETH_ADDRESS=0x4200000000000000000000000000000000000006
POOL_ADDRESS=0x9249F441005947831eaAF9135B319AD97BCD6Bdf
QUOTER_V2_ADDRESS=0x254cF9E1E6e233aa1AC962CB9B05b2cfeAaE15b0
NPM_ADDRESS=0x827922686190790b37229fd06084350E74485b72

# State file path (relative to cwd or absolute)
STATE_FILE=data/state.json
